# Include essential files for PyPI package
include README.md
include LICENSE

# Include only the core package
recursive-include basicami *.py

# Exclude development files
exclude tests/*
exclude CLAUDE.md

# Exclude build artifacts and caches
global-exclude __pycache__/*
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude .git*
global-exclude .DS_Store
